# GrandStay CRM - Environment Configuration
PROJECT_NAME="GrandStay Hospitality Management CRM"
API_V1_STR="/api/v1"

# Database Configuration (MySQL 8.0)
DATABASE_URL="mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/hospitality_crm?charset=utf8mb4"

# Security & JWT Token Generation
# Generate a strong 256-bit random key in production
SECRET_KEY="grandstay_super_secret_jwt_encryption_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
